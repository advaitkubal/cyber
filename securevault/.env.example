# SecureVault Environment Variables Example
# In production, generate fresh random secrets and never commit the .env file.

# Secret key for signing Flask session cookies (64 hex characters or 32 random bytes)
SECRET_KEY=replace_with_a_secure_random_hex_string_in_production

# 32-byte master encryption key, base64 encoded (used with HKDF for user keys)
ENCRYPTION_MASTER_KEY=replace_with_base64_encoded_32_random_bytes

# Set to True when deploying behind HTTPS to enforce Secure cookies
COOKIE_SECURE=False

# SQLite database file path
DATABASE_PATH=securevault.db

# Enable or disable rate limiting (set to False during fast automated tests if needed)
RATELIMIT_ENABLED=True
